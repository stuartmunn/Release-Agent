{
  "name": "release-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Releasebot → Telegram daily digest with Claude-powered follow-ups.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "digest:now": "tsx src/digest.ts --now",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "better-sqlite3": "^11.8.0",
    "grammy": "^1.30.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
