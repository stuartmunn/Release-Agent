# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Releasebot ---
# API key from https://releasebot.io/notifications  (format: rb_ + 32 chars)
RELEASEBOT_API_KEY=rb_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your plan: "free" (250 credits/mo) or "pro" (~$5/mo, unlimited).
RELEASEBOT_TIER=free

# --- Claude Agent SDK ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cheapest capable model; override if digests need more depth.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Telegram ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The only chat allowed to talk to the bot (your own chat id).
TELEGRAM_CHAT_ID=000000000

# --- Scheduling / runtime ---
TZ=Europe/London
DIGEST_CRON=30 8 * * *
# Days with at most this many releases get a plain (non-AI, token-free) digest.
# Only busier days pay for an AI rollup. 0 = always use AI.
DIGEST_AI_THRESHOLD=8
